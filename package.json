{
  "name": "foundry",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "dev:web": "npm --workspace web run dev",
    "db:migrate": "npm --workspace @foundry/factory run migrate",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@foundry/factory": "*",
    "@vercel/connect": "2.7.0",
    "ai": "^7.0.172",
    "eve": "^1.0.0-rc.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.x"
  }
}
