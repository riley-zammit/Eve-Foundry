generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// A factory is built around one orchestrator agent (slot 0). Subagents take slots 1-3
// (a check constraint in the migration enforces the range). Channels and schedules belong
// to the factory, so they can only ever trigger the orchestrator.
model Factory {
    id            String         @id @default(cuid())
    name          String
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    // Library folders (LibraryFolder[] in src/index.ts). Only the builder's sidebar reads them.
    folders       Json           @default("[]")
    agents        Agent[]
    skills        Skill[]
    connections   Connection[]
    channels      Channel[]
    schedules     Schedule[]
    toolGates     ToolGate[]
    tools         Tool[]
    pluginSecrets PluginSecret[]
}

// A tool in the library: a catalog template (src/prebuilt-tools.ts) under its own name and
// settings. The template's code runs it and never changes. A factory can add the same template
// more than once, say to run two image models. Its gate is keyed by its id, so a rename keeps it.
model Tool {
    id          String      @id @default(cuid())
    factoryId   String
    factory     Factory     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    // The catalog template it runs, such as `web_fetch`.
    template    String
    // What the model calls it.
    name        String
    // What the model reads about the tool. Empty uses the template's.
    description String      @default("")
    // An AI Gateway model id, for templates that call a model. Empty uses the template's default.
    model       String      @default("")
    createdAt   DateTime    @default(now())
    agents      AgentTool[]

    @@unique([factoryId, name])
}

// A value for an env var a plugin declares, such as an API token. Factory-level, so scheduled
// turns can use it without anyone signing in. `encrypted` is AES-256-GCM under
// FOUNDRY_SECRETS_KEY (src/secrets.ts); the builder only ever learns which names are set.
model PluginSecret {
    factoryId String
    factory   Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    pluginId  String
    name      String
    encrypted String
    updatedAt DateTime @updatedAt

    @@id([factoryId, pluginId, name])
}

// Approval for one tool in a factory. The key is a library tool's id, a plugin tool name
// (`ffmpeg`), or a connection tool id (`connectionId:toolName`).
model ToolGate {
    factoryId String
    factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    toolKey   String
    // never, once, always, or auto. Gates the call before it runs.
    run       String  @default("never")
    // What `auto` checks the call against, as eve auto() instructions. Empty uses eve's risk review.
    criterion String  @default("")
    // never or always. A person accepts the output before the agent continues.
    result    String  @default("never")

    @@id([factoryId, toolKey])
}

model Agent {
    id           String            @id @default(cuid())
    factoryId    String
    factory      Factory           @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    slot         Int
    name         String
    description  String            @default("")
    model        String
    instructions String            @default("")
    // Plugin catalog ids. Each plugin brings its own tools and skills.
    plugins      String[]          @default([])
    y            Float             @default(0)
    skills       AgentSkill[]
    tools        AgentTool[]
    connections  AgentConnection[]

    @@unique([factoryId, slot])
}

// Library: authored once per factory, attached to any of its agents.
model Skill {
    id          String       @id @default(cuid())
    factoryId   String
    factory     Factory      @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    name        String
    description String       @default("")
    content     String       @default("")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    agents      AgentSkill[]

    @@unique([factoryId, name])
}

// An MCP server. A server that needs sign-in has a ConnectionCredential once someone signs in.
model Connection {
    id         String                @id @default(cuid())
    factoryId  String
    factory    Factory               @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    name       String
    url        String                @default("")
    createdAt  DateTime              @default(now())
    agents     AgentConnection[]
    credential ConnectionCredential?

    @@unique([factoryId, name])
}

// A connection's sign-in, made in the builder (src/auth). It belongs to the factory's connection,
// not to whoever is chatting, so scheduled turns can use it. Only the runtime's getToken reads the
// tokens, for one call. The builder and agents never see them.
model ConnectionCredential {
    connectionId   String     @id
    connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    // vercel-connect, client-metadata, or dynamic-registration.
    method         String
    // The URL it signed in to. Tokens are only ever sent there.
    serverUrl      String
    // vercel-connect: the Connect connector id. Connect keeps the tokens.
    connector      String?
    // client-metadata and dynamic-registration: tokens and client, AES-256-GCM (src/secrets.ts).
    encrypted      String?
    // When the access token expires. Null when the server didn't say.
    expiresAt      DateTime?
    // The server rejected a refresh. Calls fail until someone signs in again.
    needsReconnect Boolean    @default(false)
    signedInAt     DateTime
}

// Foundry's registration with an OAuth server, from dynamic client registration. Shared by every
// factory: it identifies Foundry, not anyone's account.
model RegisteredClient {
    issuer          String
    redirectUri     String
    clientId        String
    // AES-256-GCM, when the server issued a secret.
    encryptedSecret String?
    // How the token endpoint takes the secret: none, client_secret_basic, or client_secret_post.
    authMethod      String
    createdAt       DateTime @default(now())

    @@id([issuer, redirectUri])
}

model AgentSkill {
    agentId String
    agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
    skillId String
    skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@id([agentId, skillId])
}

model AgentTool {
    agentId String
    agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
    toolId  String
    tool    Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

    @@id([agentId, toolId])
}

model AgentConnection {
    agentId       String
    agent         Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
    connectionId  String
    connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    // false means every tool the server publishes. true means `allowedTools` is the allow list.
    restrictTools Boolean    @default(false)
    allowedTools  String[]   @default([])

    @@id([agentId, connectionId])
}

model Channel {
    id        String   @id @default(cuid())
    factoryId String
    factory   Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    kind      String
    enabled   Boolean  @default(true)
    y         Float    @default(0)
    createdAt DateTime @default(now())

    @@unique([factoryId, kind])
}

model Schedule {
    id        String   @id @default(cuid())
    factoryId String
    factory   Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    name      String   @default("")
    cron      String   @default("0 9 * * *")
    task      String   @default("")
    enabled   Boolean  @default(true)
    y         Float    @default(0)
    createdAt DateTime @default(now())
}
